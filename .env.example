# Copy to .env and adjust. Every value below is optional and shows its default.

APP_ENV=dev

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# text (readable, the default) or json (one object per line; the API image uses json)
LOG_FORMAT=text

# Geocoding provider: open_meteo (free, no key) or geonames (needs a free username)
GEOCODING_PROVIDER=open_meteo
# Required only when GEOCODING_PROVIDER=geonames — register at https://www.geonames.org/login
GEONAMES_USERNAME=

# Timeout for calls to external APIs, in seconds
HTTP_TIMEOUT_SECONDS=5

# Redis cache (docker compose up -d). The app keeps working without it, just slower.
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.5

# Cache lifetimes, in seconds
CACHE_TTL_GEOCODING_SECONDS=604800
CACHE_TTL_CURRENT_SECONDS=600
CACHE_TTL_FORECAST_SECONDS=3600
